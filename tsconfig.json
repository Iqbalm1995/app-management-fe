{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "src/app/(pages)/requirements/brd/detail/requirementDetailInfoSection.bak"
, "src/app/(pages)/kanban/page copy.tsx.bak", "src/app/(pages)/projects-manager/page copy.tsx.bak", "src/app/(pages)/basePage.tsx.bak", "src/app/(pages)/requirements/brd/detail/brdDetailView.bak", "src/app/(pages)/requirements/brd/detail/requirementBacklogsSection.tsx.bak", "src/app/(pages)/requirements/brd/detail/requirementApprovalSection.tsx.bak", "src/app/(pages)/requirements/brd/detail/requirementFilesSection.tsx.bak", "src/app/components/sidebar-old.bak"  ],
  "exclude": ["node_modules"]
}
