          alignItems="center"
          rounded={radiusStyle}
          border="1px"
          borderColor="gray.200"
          boxShadow="md"
          overflowX="auto"
        >
          <Box minWidth="max-content">
            <Stepper
              index={activeStep}
              gap="8"
              orientation="horizontal"
              w="max-content"
            >
              {stepsProgress.map((step, index) => (
                <Step key={index}>
                  <StepIndicator>
                    <StepStatus
                      complete={<StepIcon />}
